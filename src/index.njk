---
layout: base.njk
bodyClass: p-accueil
---
<div class="cadre">
  <div class="tableau">
    <section class="carte-intro" aria-labelledby="t-intro">
      <p class="surtitre">Portfolio · {{ site.titre }}</p>
      <h1 id="t-intro">Ilyaes Satirer</h1>
      <p class="carte-intro__texte">{{ site.accroche }}</p>
      <ul class="infos">
        <li>{{ site.ville }}</li>
        <li>Permis B, véhiculé</li>
        <li>Anglais C1 · Espagnol B2</li>
      </ul>
      <p class="actions">
        <a class="bouton bouton--plein" href="/cv/">Voir mon CV</a>
        <a class="bouton bouton--contour" href="/realisations/">Mes réalisations</a>
      </p>
    </section>

    <section class="chiffres" aria-label="En chiffres">
      <a href="/realisations/"><strong>{{ collections.realisations.length }}</strong><span>réalisations</span></a>
      <a href="/veille/"><strong>{{ collections.veille.length }}</strong><span>actualités de veille</span></a>
      <a href="#certifs"><strong>{{ certifications.obtenues.length }}</strong><span>certifications et cours</span></a>
      <a href="/e5/"><strong>5</strong><span>semaines de stage</span></a>
    </section>

    <section class="tuile tuile--parcours" aria-labelledby="t-parcours">
      <div class="tuile__tete"><h2 id="t-parcours">Parcours</h2><a class="lien-fleche" href="/cv/">CV complet</a></div>
      <ol class="mini-frise">
        {% for p in cv.parcours %}{% if p.type != "Emploi" %}
        <li><span class="mini-frise__date">{{ p.dates }}</span><strong>{{ p.titre }}</strong><span>{{ p.lieu }}</span></li>
        {% endif %}{% endfor %}
      </ol>
    </section>

    <section class="tuile tuile--comp" aria-labelledby="t-comp">
      <div class="tuile__tete"><h2 id="t-comp">Compétences techniques</h2></div>
      <ul class="puces">
        {% for c in cv.competences %}<li>{{ c }}</li>{% endfor %}
      </ul>
    </section>

    <section class="tuile tuile--exp" aria-labelledby="t-exp">
      <div class="tuile__tete"><h2 id="t-exp">Expériences</h2></div>
      <ul class="liste-fine">
        {% for p in cv.parcours %}{% if p.type == "Emploi" %}<li><strong>{{ p.titre }}</strong><span>{{ p.lieu }} · {{ p.dates }}</span></li>{% endif %}{% endfor %}
      </ul>
    </section>

    <section class="tuile tuile--qual" aria-labelledby="t-qual">
      <div class="tuile__tete"><h2 id="t-qual">Qualités</h2></div>
      <ul class="etiquettes">{% for q in cv.qualites %}<li>{{ q }}</li>{% endfor %}</ul>
      <div class="tuile__tete tuile__tete--suite"><h2>Centres d'intérêt</h2></div>
      <ul class="etiquettes">{% for i in cv.interets %}<li>{{ i }}</li>{% endfor %}</ul>
    </section>
  </div>

  <section class="section" aria-labelledby="t-reals">
    <div class="section__tete">
      <h2 id="t-reals">Réalisations par domaine</h2>
      <a class="lien-fleche" href="/realisations/">Toutes les réalisations</a>
    </div>
    <div class="domaines">
      {% for cat in categories %}
      {% set items = collections.realisations | parCategorie(cat.cle) %}
      {% if items.length %}
      <a class="domaine teinte-{{ cat.teinte }}" href="/realisations/?cat={{ cat.cle }}">
        <span class="domaine__haut"><span class="domaine__nom">{{ cat.nom }}</span><span class="domaine__nb">{{ items.length }}</span></span>
        <ul>{% for r in items %}<li>{{ r.data.title }}</li>{% endfor %}</ul>
      </a>
      {% endif %}
      {% endfor %}
    </div>
  </section>

  <section class="section" aria-labelledby="t-veille">
    <div class="section__tete">
      <h2 id="t-veille">Dernières actualités de veille</h2>
      <a class="lien-fleche" href="/veille/">Toute la veille</a>
    </div>
    <div class="une">
      {% for a in collections.veille | limite(3) %}
      {% set ax = axes | trouve("num", a.data.axe) %}
      <a class="une__carte axe-{{ a.data.axe }}{% if loop.first %} une__carte--grande{% endif %}" href="{{ a.url }}">
        <span class="une__meta"><span class="pastille">{{ ax.nom }}</span><time datetime="{{ a.date | dateIso }}">{{ a.date | dateLongue }}</time></span>
        <span class="une__titre">{{ a.data.title }}</span>
        {% if loop.first %}<span class="une__resume">{{ a.data.resume }}</span>{% endif %}
      </a>
      {% endfor %}
    </div>
  </section>

  <section class="section" id="certifs" aria-labelledby="t-certifs">
    <div class="section__tete">
      <h2 id="t-certifs">Certifications et cours en ligne</h2>
    </div>
    <ul class="certifs">
      {% for c in certifications.obtenues %}
      <li>
        <span class="certifs__org">{{ c.org }}</span>
        <strong>{{ c.nom }}</strong>
        <span class="certifs__detail">{{ c.detail }}</span>
        {% if c.date %}<span class="certifs__date">{{ c.date }}</span>{% endif %}
      </li>
      {% endfor %}
      <li class="certifs--suite">
        <span class="certifs__org">Prochain cours</span>
        <strong>{{ certifications.prochaine.nom }}</strong>
        <span class="certifs__detail">{{ certifications.prochaine.detail }}</span>
      </li>
    </ul>
  </section>
</div>
