---
layout: base.njk
---
{% set cat = null %}
{% for c in categories %}{% if c.cle == categorie %}{% set cat = c %}{% endif %}{% endfor %}
<article class="fiche cadre">
  <p class="fil-ariane"><a href="/realisations/">Réalisations</a> <span aria-hidden="true">/</span> {{ cat.nom }}</p>
  <h1 class="fiche__titre fil fil--{{ cat.fil }}">{{ title }}</h1>
  <p class="fiche__resume">{{ resume }}</p>

  <dl class="fiche__meta">
    {% if contexte %}<div><dt>Contexte</dt><dd>{{ contexte }}</dd></div>{% endif %}
    {% if periode %}<div><dt>Période</dt><dd>{{ periode }}</dd></div>{% endif %}
    {% if outils and outils.length %}<div><dt>Outils et technologies</dt><dd>{{ outils | join(", ") }}</dd></div>{% endif %}
  </dl>

  <div class="fiche__corps prose">
    {{ content | safe }}
  </div>

  <aside class="fiche__comps" aria-labelledby="t-comps">
    <h2 id="t-comps">Compétences de l'épreuve E5</h2>
    <ul class="grille-comps">
      {% for c in competencesE5 %}
      <li class="{% if c.cle in (competences or []) %}oui{% else %}non{% endif %}">
        <span class="marque-comp" aria-hidden="true">{% if c.cle in (competences or []) %}✓{% endif %}</span>
        <span>{{ c.libelle }}</span>
        <span class="sr">{% if c.cle in (competences or []) %} : mobilisée{% else %} : non mobilisée{% endif %}</span>
      </li>
      {% endfor %}
    </ul>
  </aside>

  <p class="retour"><a class="lien-fort" href="/realisations/">Toutes les réalisations</a></p>
</article>
