---
layout: base.njk
bodyClass: p-article
---
{% set ax = axes | trouve("num", axe) %}
{% set plusRecent = collections.veille | getPreviousCollectionItem(page) %}
{% set plusAncien = collections.veille | getNextCollectionItem(page) %}
<article class="cadre lecture axe-{{ axe }}">
  <header class="lecture__tete">
    <p class="fil-ariane"><a href="/veille/">Veille</a> <span aria-hidden="true">/</span> <span class="pastille">Axe {{ axe }} · {{ ax.nom }}</span></p>
    <h1>{{ title }}</h1>
    <p class="lecture__chapo">{{ resume }}</p>
    <p class="lecture__date">Actualité du <time datetime="{{ page.date | dateIso }}">{{ page.date | dateLongue }}</time></p>
  </header>

  <div class="prose prose--lecture">
    {{ content | safe }}
  </div>

  {% if sources and sources.length %}
  <section class="sources" aria-labelledby="t-sources">
    <h2 id="t-sources">Sources</h2>
    <ul>
      {% for s in sources %}<li><a href="{{ s.url }}"><span>{{ s.media }}</span>{{ s.titre }}</a></li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  <nav class="suite" aria-label="Autres actualités">
    {% if plusAncien %}<a class="suite__lien" href="{{ plusAncien.url }}"><span>Plus ancienne</span>{{ plusAncien.data.title }}</a>{% else %}<span></span>{% endif %}
    {% if plusRecent %}<a class="suite__lien suite__lien--droite" href="{{ plusRecent.url }}"><span>Plus récente</span>{{ plusRecent.data.title }}</a>{% endif %}
  </nav>
</article>
