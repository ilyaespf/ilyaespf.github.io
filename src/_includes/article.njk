---
layout: base.njk
---
{% set ax = null %}
{% for a in axes %}{% if a.num == axe %}{% set ax = a %}{% endif %}{% endfor %}
<article class="fiche cadre">
  <p class="fil-ariane"><a href="/veille/">Veille cybersécurité</a> <span aria-hidden="true">/</span> Axe {{ axe }} : {{ ax.nom }}</p>
  <h1 class="fiche__titre">{{ title }}</h1>
  <p class="fiche__resume">{{ resume }}</p>
  <p class="article-date">Actualité du <time datetime="{{ page.date | dateIso }}">{{ page.date | dateLongue }}</time></p>

  <div class="fiche__corps prose">
    {{ content | safe }}
  </div>

  {% if sources and sources.length %}
  <aside class="sources" aria-labelledby="t-sources">
    <h2 id="t-sources">Sources</h2>
    <ul>
      {% for s in sources %}<li><a href="{{ s.url }}">{{ s.titre }}</a>{% if s.media %}, {{ s.media }}{% endif %}</li>{% endfor %}
    </ul>
  </aside>
  {% endif %}

  <p class="retour"><a class="lien-fort" href="/veille/">Toute la veille</a></p>
</article>
