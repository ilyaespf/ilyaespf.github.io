{% for cat in categories %}
{% set items = collections.realisations | parCategorie(cat.cle) %}
{% if items.length %}
<section class="groupe" aria-labelledby="cat-{{ cat.cle }}">
  <h3 class="groupe__titre fil fil--{{ cat.fil }}" id="cat-{{ cat.cle }}">{{ cat.nom }}</h3>
  <ul class="reals">
    {% for r in items %}
    <li class="real">
      <a class="real__lien" href="{{ r.url }}">
        <span class="real__titre">{{ r.data.title }}</span>
        <span class="real__resume">{{ r.data.resume }}</span>
      </a>
      {% if r.data.competences and r.data.competences.length %}
      <ul class="comps" aria-label="Compétences E5 mobilisées">
        {% for c in competencesE5 %}{% if r.data.competences.includes(c.cle) %}<li title="{{ c.libelle }}">{{ c.court }}</li>{% endif %}{% endfor %}
      </ul>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}
{% endfor %}
